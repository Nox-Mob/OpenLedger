{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "OpenLedgerApp",
  "version": "0.1.0",
  "identifier": "com.openledgerapp.dev",
  "build": {
    "frontendDist": "../.output/public",
    "devUrl": "http://localhost:8080",
    "beforeDevCommand": "npm run dev:desktop",
    "beforeBuildCommand": "npm run build:desktop"
  },
  "app": {
    "windows": [
      {
        "title": "OpenLedgerApp",
        "width": 1280,
        "height": 860,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}