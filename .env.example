VITE_SUPABASE_URL=https://<your-project-ref>.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=<publishable key>
VITE_SUPABASE_PROJECT_ID=<your-project-ref>
SUPABASE_URL=https://<your-project-ref>.supabase.co
SUPABASE_PUBLISHABLE_KEY=<publishable key>
SUPABASE_SERVICE_ROLE_KEY=<service-role key - server only>
# Optional: AI-assisted PDF import
LOVABLE_API_KEY=
# Leave unset in production
# VITE_ALLOW_DEMO_LOGIN=true

# Server-only. Signs backups so edited files are refused on restore. Use 64+ random characters
# (e.g. `openssl rand -hex 32`) and keep it stable: changing it makes old backups "from another install".
BACKUP_SIGNING_SEED=<random secret>
